# Normalise line endings so that a Windows checkout does not produce a diff on
# every file the next time someone touches it. Without this, `git add` warns
# "LF will be replaced by CRLF" on hundreds of files and every subsequent PR
# carries whitespace-only churn that hides the real change.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.zip binary

# Lockfiles are generated; keep them out of language stats and diff review noise.
uv.lock linguist-generated=true
frontend/mobile/pnpm-lock.yaml linguist-generated=true

# The migrated mobile app is TypeScript. Without this, GitHub reports the repo
# as majority-TypeScript when the canonical backend is Python.
frontend/** linguist-vendored=false
frontend/mobile/research/** linguist-documentation=true
