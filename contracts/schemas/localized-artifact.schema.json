{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifamily.invalid/contracts/localized-artifact.schema.json",
  "title": "AiFamily Localized Artifact",
  "description": "Versioned reviewed text keyed by a stable concept, never by translated text.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "concept_id": { "type": "string", "minLength": 1 },
    "artifact_kind": {
      "type": "string",
      "enum": ["PROMPT", "KNOWLEDGE", "ERROR_CODE", "HUMAN_GATE"]
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "version": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "review_status": {
      "type": "string",
      "enum": ["DRAFT", "REVIEWED", "RETIRED"]
    }
  },
  "required": [
    "concept_id",
    "artifact_kind",
    "locale",
    "version",
    "text",
    "review_status"
  ]
}
